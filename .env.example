# ---- volume tier (OpenAI-compatible) ----------------------------------------
# Ollama on laptop: http://localhost:11434/v1
# Ollama on homelab: http://<homelab-ip>:11434/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3.5:9b

# OpenRouter = the "fuck it, burn credits" switch for the volume tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- quality tier ------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- role routing: "provider" or "provider:model" ----------------------------
# providers: local | openrouter | anthropic
# Local broken today? ROLE_EXTRACT=openrouter:some/cheap-model etc.
ROLE_EXTRACT=local
ROLE_SCORE=local
ROLE_ESCALATE=anthropic:claude-haiku-4-5
# Jev "worth a look?" gate (typed judgments, not prose) — see app/gate.py.
# Runs through OpenRouter's System One endpoint on OPENROUTER_API_KEY.
ROLE_GATE=openrouter:~typesafe/jev-latest

# ---- pipeline ----------------------------------------------------------------
ESCALATE_MIN_SCORE=55
# evals scoring below this are auto-skipped (kept on the Jobs page, never
# surfaced for review). Set to 0 to review everything.
REVIEW_MIN_SCORE=50
# Review-queue freshness (days since a source last listed the job):
# within RECENT_SEEN_DAYS → "seen recently"; at/over STALE_AFTER_DAYS → moved
# to the stale view instead of the main review list.
RECENT_SEEN_DAYS=7
STALE_AFTER_DAYS=45
MONTHLY_BUDGET_USD=10
BUDGET_FALLBACK_TO_LOCAL=true
PIPELINE_HOUR=2

# ---- notifications -------------------------------------------------------------
# Discord webhook: pipeline finished (with stats) / crashed. Server Settings →
# Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=
# healthchecks.io: one dead-man's-switch check per scheduled job — pings on
# success, catches "the cron silently stopped running" that a fire-on-error
# notification can't. Separate checks so one job's silence doesn't mask the
# other's. Base check URLs, no trailing /fail.
HEALTHCHECKS_PIPELINE_URL=
HEALTHCHECKS_LIVENESS_URL=

# ---- sources -----------------------------------------------------------------
# Shared search geography for all applicants: Adzuna queries that omit "where"
# search this center + radius (km). 25km from Seattle covers Bellevue,
# Kirkland, and Redmond.
#SEARCH_WHERE=Seattle, WA
#SEARCH_DISTANCE_KM=25

# Adzuna (general aggregator) — free keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# USAJobs (US federal) — free key: https://developer.usajobs.gov/apirequest/
# USAJOBS_EMAIL must be the email the key is registered to.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Greenhouse / Lever / Ashby boards and RemoteOK need no keys — they're
# configured per-applicant in the profile's "sources" block.

DATA_DIR=data
